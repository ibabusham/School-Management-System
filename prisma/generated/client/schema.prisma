// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  password      String
  role          Role
  accountStatus Boolean  @default(true)
  createdAt     DateTime @default(now())

  teacher       Teacher?
  student       Student?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Teacher {
  id            String  @id
  name          String
  employId      Int     @unique
  email         String
  phoneNumber   String
  specilization String
  accountStatus Boolean @default(true)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  subjects      Subjects[]
  progressNotes ProgressNotes[]
}

model Student {
  id                 String   @id
  studentId          Int      @unique
  firstName          String
  lastName           String
  email              String
  accountStatus      Boolean  @default(true)
  dateOfBirth        DateTime
  phoneNumber        String?
  enrollmentDate     DateTime
  learningProgressId String   @unique
  classId            String?
  gender             Gender

  user             User               @relation(fields: [id], references: [id], onDelete: Cascade)
  class            Classes?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  learningProgress LearningProgresses @relation(fields: [learningProgressId], references: [id], onDelete: Restrict)

  attendances           Attendences[]
  examSubmissions       ExamSubmissions[]
  assignmentSubmissions AssignmentSubmissions[]
}

enum Gender {
  MALE
  FEMALE
}

model Classes {
  id        String @id @default(uuid())
  className String

  academicYears ClassAcademicYear[]
  students      Student[]
  subjects      Subjects[]
  performance   ClassesPerformence?
}

model Subjects {
  id          String @id @default(uuid())
  subjectName String
  subjectCode String
  description String
  classId     String
  teacherId   String

  class   Classes @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  assignments Assignments[]
  lessons     Lessons[]
  exams       Exams[]
  attendances Attendences[]
}

enum Status {
  ACTIVE
  INACTIVE
}

model AcademicYears {
  id        String   @id @default(uuid())
  yearName  String
  startDate DateTime
  endDate   DateTime
  status    Status

  classes ClassAcademicYear[]
  terms   Terms[]
}

model Terms {
  id        String   @id @default(uuid())
  termName  String
  startDate DateTime
  endDate   DateTime
  yearId    String

  year AcademicYears @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model ClassAcademicYear {
  classId String
  yearId  String

  class Classes       @relation(fields: [classId], references: [id], onDelete: Cascade)
  year  AcademicYears @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@id([classId, yearId])
}

model Assignments {
  id                     String   @id @default(uuid())
  assignmentTitle        String
  assignmentDescription  String
  dueDate                DateTime
  maximumGrade           Int
  attachment             String
  submissionInstructions String
  subjectId              String

  submissions AssignmentSubmissions[]
  subject     Subjects                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Lessons {
  id                 String      @id @default(uuid())
  lessonTitle        String
  lessonDescription  String
  lessonDate         DateTime
  learningObjectinve String
  learningMaterial   String
  completionStatus   iscompleate
  subjectId          String

  subject Subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

enum iscompleate {
  COMPLEATED
  INCOMPLEATE
}

model Exams {
  id           String   @id @default(uuid())
  examName     String
  examDate     DateTime
  maximumGrade Int
  subjectId    String

  subject     Subjects          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions ExamSubmissions[]
}

model LearningProgresses {
  id                   String @id @default(uuid())
  subjectsAverages     Int
  overallAvreages      Int
  attendencePercentage Int
  learningStatus       Status

  student       Student?
  progressNotes ProgressNotes[]
}

model ProgressNotes {
  id                  String   @id @default(uuid())
  noteDate            DateTime
  noteObservation     String
  strengths           String
  areasForImprovement String
  teacherId           String
  learningProgressId  String

  teacher          Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  learningProgress LearningProgresses @relation(fields: [learningProgressId], references: [id], onDelete: Cascade)
}

model ClassesPerformence {
  id                         String @id @default(uuid())
  classAvg                   Int
  highestGrade               Int
  lowestGrade                Int
  assignmentsCompleationRate Int
  attendenceRate             Int
  studentRequiringSupport    Int
  classStatus                Status
  classId                    String @unique

  class Classes @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Attendences {
  id                   String   @id @default(uuid())
  attendanceDate       DateTime
  attendanceStatus     String
  attendancePercentage Int
  studentId            String
  subjectId            String

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model ExamSubmissions {
  id        String   @id @default(uuid())
  examId    String
  studentId String
  score     Int?
  takenAt   DateTime @default(now())

  exam    Exams   @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model AssignmentSubmissions {
  id           String   @id @default(uuid())
  assignmentID String
  studentId    String
  score        Int?
  takenAt      DateTime @default(now())

  assignment Assignments @relation(fields: [assignmentID], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentID, studentId])
}
