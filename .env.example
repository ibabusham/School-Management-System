# PostgreSQL connection (Prisma + app)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_management?schema=public"

# JWT secrets — use long random strings in .env (32+ chars each).
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_RESET_SECRET="change-me-reset-secret-min-32-chars"
